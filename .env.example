SPRINTER_ENVIRONMENT=production
SPRINTER_HOST=127.0.0.1
SPRINTER_PORT=8080
SPRINTER_DATABASE_PATH=/var/lib/sprinter/sprinter.db
SPRINTER_LOG_LEVEL=INFO
SPRINTER_SECRETS_DIR=./secrets

# Generate a salted verifier with: python scripts/hash_token.py
# Format: name:scrypt-verifier:scope,scope;name2:scrypt-verifier:scope
SPRINTER_API_TOKEN_RECORDS=operator:replace-with-scrypt-verifier:admin
SPRINTER_MAX_BODY_BYTES=1048576
SPRINTER_RATE_LIMIT_PER_MINUTE=60
SPRINTER_JOB_RETENTION_DAYS=90
SPRINTER_EVIDENCE_RETENTION_DAYS=180
SPRINTER_AUDIT_RETENTION_DAYS=365

SPRINTER_PI_COMMAND=pi
SPRINTER_PI_EXPECTED_VERSION=0.83.0
SPRINTER_PI_PROVIDER=openrouter
SPRINTER_PI_MODEL=replace-with-model-id
SPRINTER_PI_THINKING=high
SPRINTER_PI_TIMEOUT_SECONDS=180
SPRINTER_PI_MAX_OUTPUT_BYTES=262144
SPRINTER_MODEL_DATA_POLICY_ACK=1
SPRINTER_PROMPT_MAX_ROWS=20
SPRINTER_PROMPT_EXTRA_REDACT_KEYS=

SPRINTER_SPLUNK_BASE_URL=
SPRINTER_SPLUNK_WEB_URL=
SPRINTER_SPLUNK_HEC_URL=
SPRINTER_SPLUNK_HEC_TOKEN_FILE=
SPRINTER_SPLUNK_USERNAME=
SPRINTER_SPLUNK_PASSWORD_FILE=
SPRINTER_SPLUNK_CA_FILE=
SPRINTER_SPLUNK_ALLOWED_INDEXES=
SPRINTER_SPLUNK_RESULTS_INDEX=

SPRINTER_ADX_CLUSTER_URL=
SPRINTER_ADX_DATABASE=
SPRINTER_ADX_TENANT_ID=
SPRINTER_ADX_CLIENT_ID=
SPRINTER_ADX_CLIENT_SECRET_FILE=
SPRINTER_ADX_ALLOWED_TABLES=

SPRINTER_CONFLUENCE_BASE_URL=
SPRINTER_CONFLUENCE_EMAIL=
SPRINTER_CONFLUENCE_API_TOKEN_FILE=
SPRINTER_CONFLUENCE_ALLOWED_SPACES=

SPRINTER_TEAMS_ENABLED=0
SPRINTER_TEAMS_APP_ID=
SPRINTER_TEAMS_TENANT_ID=
SPRINTER_TEAMS_CLIENT_SECRET_FILE=
SPRINTER_TEAMS_ALLOWED_TENANT_IDS=
SPRINTER_TEAMS_PUBLIC_BASE_URL=
