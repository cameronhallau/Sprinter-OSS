{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.27/MicrosoftTeams.schema.json",
  "manifestVersion": "1.27",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "developer": {
    "name": "Sprinter contributors",
    "websiteUrl": "{{PROJECT_URL}}",
    "privacyUrl": "{{PRIVACY_URL}}",
    "termsOfUseUrl": "{{TERMS_URL}}"
  },
  "name": {
    "short": "Sprinter",
    "full": "Sprinter Security Review"
  },
  "description": {
    "short": "Evidence-backed security review notifications.",
    "full": "Sprinter sends concise, evidence-backed security detection review notifications. It does not accept messages or commands in Teams."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#C1121F",
  "bots": [
    {
      "botId": "{{TEAMS_APP_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "isNotificationOnly": true,
      "supportsFiles": false
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["{{PUBLIC_HOSTNAME}}"]
}
